APP_NAME="Rajahemat Cafe"
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------
# POS Rajahemat Cafe — kebijakan uang & operasional (Gate 0).
# Angka final harus disetujui owner sebelum transaksi produksi.
# ------------------------------------------------------------------
POS_TAX_PERCENT=10
POS_SERVICE_PERCENT=5
POS_MAX_CASHIER_DISCOUNT=10

# Pendaftaran pelanggan baru dibuka hanya setelah teks legal/privacy disetujui.
POS_CUSTOMER_REGISTRATION_OPEN=true

# Saldo pelanggan (R1.1).
POS_WALLET_DAILY_TOPUP_LIMIT=2000000
POS_WALLET_MIN_TOPUP=10000

# Verifikasi email pelanggan — aktifkan setelah SMTP hosting lolos Gate 0.
POS_REQUIRE_CUSTOMER_EMAIL_VERIFICATION=false

# ------------------------------------------------------------------
# Payment Gateway Midtrans (R1.2). Server key hanya di server.
# Jangan aktifkan sebelum akun sandbox & kebijakan owner (Gate 0) siap.
#
# Sandbox:  MIDTRANS_IS_PRODUCTION=false, MIDTRANS_IS_SANDBOX=true
# Live:     MIDTRANS_IS_PRODUCTION=true,  MIDTRANS_IS_SANDBOX=false
#           (POS_MIDTRANS_SERVER_KEY & POS_PAYLOAD_KEY wajib terisi)
# Webhook yang didaftarkan di dashboard Midtrans:
#           {APP_URL}/midtrans/webhook   (HTTP POST)
# ------------------------------------------------------------------
MIDTRANS_ENABLED=false
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANDBOX=true
MIDTRANS_PAUSED=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
# Server key sengaja memakai prefix POS_ agar tidak pernah ter-bundle ke frontend.
POS_MIDTRANS_SERVER_KEY=
POS_MIDTRANS_SERVER_KEY_ROTATION=
POS_PAYLOAD_KEY=

# Monitoring & batas webhook (default aman; ubah hanya jika perlu).
# POS_MIDTRANS_WEBHOOK_TIMEOUT_SECONDS=10
# POS_MIDTRANS_MAX_PAYLOAD_BYTES=65536
# POS_MIDTRANS_OVERPAYMENT_CAP_PERCENT=0.02

VITE_APP_NAME="${APP_NAME}"
